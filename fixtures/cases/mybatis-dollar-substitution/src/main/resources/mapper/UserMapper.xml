<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="p.UserMapper">
  <select id="findByName" resultType="p.User">
    select * from t_user where name = '${name}'
  </select>
  <select id="orderBy" resultType="p.User">
    select * from t_user order by ${sortColumn}
  </select>
  <select id="safe" resultType="p.User">
    <!-- 示例：where name = ${name} 应该改成 #{} -->
    select * from t_user where name = #{name}
  </select>
</mapper>
